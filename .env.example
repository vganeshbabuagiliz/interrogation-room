# Copy to .env and fill in. Never commit .env.
# Decider: the AWS User Group Madurai hosted API (key from their platform), or a local `strands-decider serve`.
DECIDER_MODE=ugmdu                     # ugmdu | local
DECIDER_URL=https://da25tnxy06gjk.cloudfront.net
DECIDER_API_KEY=
# local only: DECIDER_MODE=local and DECIDER_URL=http://localhost:8099

# Amazon Bedrock models (ids or inference profiles enabled in your account and region)
AWS_REGION=us-east-1
BEDROCK_MODEL_FAST=
BEDROCK_MODEL_STRONG=
